# ==============================================================================
# StoreDash environment variables
#
# This is a monorepo with three deployable units, each with its OWN .env file
# (copy the relevant section below into backend/.env, apps/customer/.env, and
# apps/admin/.env). Nothing prefixed VITE_ is secret — it ships in the browser
# bundle. Everything under "backend/.env" must never be exposed to a frontend.
# ==============================================================================

# ------------------------------------------------------------------------------
# backend/.env  (Render / server-only — NEVER exposed to any frontend)
# ------------------------------------------------------------------------------

# Single Postgres connection string (Cloud SQL or otherwise). Example for a
# public Cloud SQL IP: postgresql://user:password@34.1.2.3:5432/storedash?sslmode=require
# Example for the Cloud SQL Auth Proxy / Unix socket on Render/Cloud Run:
# postgresql://user:password@/storedash?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Must match the Firebase project used by the frontends' VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Base64-encoded Firebase service account JSON (Project Settings > Service
# Accounts > Generate new private key, then `base64 -w0 key.json`).
# Required when hosting off-GCP (e.g. Render). On GCP compute this can be left
# empty in favor of Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_BASE64=

NODE_ENV=development
PORT=3001

# Supabase Storage, used for product/service/store images (see README
# "Image uploads"). Project Settings > API in the Supabase dashboard.
# SUPABASE_URL is the "Project URL". SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key — NEVER the "anon public" key, and NEVER put
# either of these in apps/admin/.env or apps/customer/.env. The service role
# key bypasses Row Level Security entirely, which is fine because it's only
# ever read here, server-side, behind this app's own auth/role checks — if
# it leaked into a frontend bundle, anyone could read/write/delete every file
# in every bucket in the project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Must match the bucket name you create in the Supabase dashboard (Storage).
SUPABASE_STORAGE_BUCKET=images

# ------------------------------------------------------------------------------
# apps/customer/.env and apps/admin/.env  (Vercel — safe to expose to the browser)
# ------------------------------------------------------------------------------

# Base URL of the deployed backend API (no trailing slash).
VITE_API_URL=http://localhost:3001

# Firebase Web SDK config. These values identify the Firebase project; they
# are not secret by design (the same way a public API base URL isn't secret),
# but they DO need this project's Firebase Console > Authentication > Settings
# > Authorized domains to be locked to your real domains, and the API key
# restricted (HTTP referrers) in Google Cloud Console > Credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# No API key needed: the customer app's map uses Leaflet + OpenStreetMap tiles.

{
  "name": "storedash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "workspaces": [
    "shared",
    "backend",
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:customer": "npm run dev --workspace=@storedash/customer",
    "dev:admin": "npm run dev --workspace=@storedash/admin",
    "build:customer": "npm run build --workspace=@storedash/customer",
    "build:admin": "npm run build --workspace=@storedash/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:push": "npm run db:push --workspace=backend"
  },
  "devDependencies": {
    "typescript": "~5.8.2",
    "tsx": "^4.21.0"
  }
}

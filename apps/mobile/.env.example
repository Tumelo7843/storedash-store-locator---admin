# StoreDash mobile app — Expo inlines any EXPO_PUBLIC_* variable into the
# built JS bundle at build time, so nothing here is secret (same trust model
# as the customer web app's VITE_* variables). Copy this file to .env and
# fill in values that match the SAME Firebase project used by apps/customer.
# Never commit the real .env file.

# Base URL of the deployed backend API (no trailing slash).
EXPO_PUBLIC_API_URL=http://localhost:3001

# Firebase Web SDK config — Firebase Console > Project settings > General >
# Your apps > (Web app). Must be the same project as apps/customer's
# VITE_FIREBASE_* values so ID tokens validate against the same backend.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth 2.0 "Web application" client ID from Google Cloud Console (the same
# one Firebase auto-created when you enabled Google sign-in) — required by
# @react-native-google-signin/google-signin as `webClientId` on both
# platforms so the returned idToken can be exchanged for a Firebase
# credential. NOT an Android/iOS client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
